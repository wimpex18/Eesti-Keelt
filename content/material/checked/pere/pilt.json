      "speaker": "a",
      "text": "Igor, see on minu pere pilt."
    },
    {
      "speaker": "b",
      "text": "Ilus pilt! Kes see mees on?"
    },
    {
      "speaker": "a",
      "text": "See on minu vend Juhan. Ta on arst."
    },
    {
      "speaker": "b",
      "text": "Ja kes see naine on?"
    },
    {
      "speaker": "a",
      "text": "See on Juhani naine Kadri. Tal on kaks poega ja üks tütar."
    },
    {
      "speaker": "b",
      "text": "Kes see väike tüdruk on?"
    },
    {
      "speaker": "a",
      "text": "See on Juhani tütar Kertu. Ja see on minu ema Aino."
    },
    {
      "speaker": "b",
      "text": "Mul on ka suur perekond. Mul on kolm venda ja üks õde."
    },
    {
      "speaker": "a",
      "text": "Kolm venda! Mis su õe nimi on?"
    },
    {
      "speaker": "b",
      "text": "Tema nimi on Olga. Ta on Sergei naine."
    }
