{
  "name": "eesti-keelt-worker",
  "private": true,
  "description": "Cloudflare Worker that fronts the Eesti-Keelt app on Cloud Run. The app itself is Python; this is only the doorman.",
  "scripts": {
    "build:web": "node deploy/build-web.mjs",
    "typecheck": "tsc --noEmit",
    "test:worker": "node --import ./tests/worker-runtime.mjs --test tests/worker*.test.mjs",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261008.1",
    "axe-core": "^4.14.0",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.148.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  },
  "allowScripts": {
    "workerd@1.20261006.1": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "esbuild@0.28.1": true
  }
}
