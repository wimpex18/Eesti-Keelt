# Copy to .env and fill in. .env is git-ignored — never commit it.
#   cp .env.example .env

# Recommended: one key, 412 models, 15 free.
# Get it at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional alternatives — any one of these enables full grammar explanations.
# GROQ_API_KEY=

# Optional: Workers AI (needs both).
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Optional: push confirmed errors into the Notion "Vead" database.
# NOTION_TOKEN=
