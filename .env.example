# Copy to .env and fill in. .env is git-ignored — never commit it.
#   cp .env.example .env
# Every key is optional; see docs/setup.md. Grammar lanes, in chain order:

# Cloudflare Workers AI (token: Account → Workers AI → Read)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# NVIDIA Build (free developer key): https://build.nvidia.com
# NVIDIA_API_KEY=

# Mistral Experiment plan (free): https://console.mistral.ai/api-keys
# MISTRAL_API_KEY=

# OpenRouter free models: https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# A local OpenAI-compatible server running EstLLM (e.g. Ollama)
# LOCAL_LLM_URL=http://localhost:11434/v1

# Hosted Whisper fallback for speech recognition
# HF_TOKEN=

# EKI's Ekilex API for the word card: your profile page at https://ekilex.ee/
# EKILEX_API_KEY=

# Send confirmed corrections to the Notion "Vead" database
# NOTION_TOKEN=
