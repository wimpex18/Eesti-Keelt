  "narrative": {
    "northStar": "Laudtee — the boardwalk across the bog",
    "overview": "A plank is laid only when code has checked it. Birch paper, black and cornflower; colour by role; tone, not outline; Onest for the interface and Literata for the language. Progress is drawn as the boardwalk, the cornflower and the beads.",
    "keyCharacteristics": [
      "One night hero per screen answers 'what now'",
      "Cornflower is action, now and readiness",
      "Estonian material in Literata, interface in Onest",
      "Rewards follow mastery, never attendance",
      "Motion explains and collapses under reduced motion"
    ],
    "rules": [
      {
        "name": "The Colour-by-Role Rule",
        "body": "Cornflower acts, moss is right, cranberry is wrong, cloudberry cautions, lake means. Never colour text by its language.",
        "section": "colors"
      },
      {
        "name": "The Never-Hue-Alone Rule",
        "body": "Every coloured state also has a shape: node icons, filled/empty/hatched petals, plan glyphs, beads that stay.",
        "section": "colors"
      },
      {
        "name": "The Serif-Is-Estonian Rule",
        "body": "Literata is reserved for Estonian material the learner reads, completes or types.",
        "section": "typography"
      },
      {
        "name": "The No-Single-Score Rule",
        "body": "No overall readiness percentage and no streak: the exam fails a zero in any part, and the flower shows it.",
        "section": "components"
      }
    ],
    "dos": [
      "Use tokens for colour and the --s1…--s7 scale",
      "Draw progress with the signature graphics",
      "Keep 44px touch targets",
      "Check 1440×900, 402×874, 874×402, 744×1133 in both themes"
    ],
    "donts": [
      "Outline surfaces to separate them",
      "Use cornflower for decoration",
