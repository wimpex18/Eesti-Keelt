  "narrative": {
    "northStar": "Practice rhythm",
    "overview": "Grove is a calm working place for learning Estonian. Spruce navigation gives the\napp a stable edge, mint opens the working area, and opaque task sheets give text,\nanswers and corrections a dependable reading surface. Comfortable humanist type\nand a restrained coral current-step mark carry the identity.\n\nThe signature is the labelled three-step strip: Õpi → Harjuta → Kontrolli. It\nborrows the rhythm of Baltic colour bands while remaining an ordinary progress\nindicator. Navigation, fields and disclosures use familiar web controls. Grove's\nleaf and name remain the identity; the interface opens directly into the app.",
    "keyCharacteristics": [
      "Spruce navigation, mint ground, opaque task surfaces.",
      "Coral current-step marks and separately labelled result states.",
      "One humanist family, with a sharper cut for Estonian material.",
      "Four persistent skills and a stable answer → correction → next-action rhythm.",
      "Short responsive layouts, readable glosses and progressive disclosure."
    ],
    "rules": [
      {
        "name": "The State Has Words Rule",
        "body": "Colour supports a visible label, icon or explicit correction; it never carries the result alone. A skipped item is labelled as ungraded and uses a neutral progress mark.",
        "section": "colors"
      },
      {
        "name": "The Shared Face Rule",
        "body": "Use the same family across languages; sharpness marks learning material. Estonian UI labels keep a Russian gloss where the MVP needs it, without colouring text merely because it is Russian.",
        "section": "typography"
      },
      {
        "name": "The Stable Workspace Rule",
        "body": "Keep one guided item in the task surface. Reserve the correction region (144px) and a separate next-action zone (at least 48px); completed answers move to an optional disclosure after the workspace.",
        "section": "layout"
      },
      {
        "name": "The Opaque Reading Rule",
        "body": "Text, answers and their explanations sit on opaque surfaces. A floating word explanation keeps the same solid task colour.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reuse spruce navigation, mint ground and opaque task surfaces through the root tokens.",
      "Do keep all four skills reachable and both bottom-skill labels at 12px.",
      "Do preserve the single guided item, reserved correction area and explicit Edasi action.",
      "Do pair colour with a readable state label, icon or correction.",
      "Do keep Estonian learning material in the sharper Geologica cut and Russian explanations in the soft cut.",
      "Do retain visible source attribution, readable limits, keyboard focus and at least 44px control targets.",
      "Do derive platform artwork from the original leaf and local font, with provenance on shipping rasters."
    ],
    "donts": [
      "Don't restore the discarded glass shell, boardwalk layout or timed opening passage as house defaults.",
