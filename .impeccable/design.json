      "html": "<div class=\"ds-drill\"><p class=\"ds-prompt\">Ma ostsin eile <b>____</b> (raamat).</p><div class=\"ds-task\"><b>raamat</b><span class=\"ds-form\">omastav</span><span class=\"ds-gloss\">книга</span><span class=\"ds-lv\">A1</span></div></div>",
      "css": ".ds-drill{border:1px solid var(--line,#e3e3de);border-radius:14px;padding:24px 16px;background:var(--bg,#faf9f6);font-family:ui-sans-serif,system-ui,-apple-system,'Segoe UI',Roboto,sans-serif}.ds-prompt{font:400 18.5px/1.6 'Iowan Old Style','Palatino Linotype',Palatino,Georgia,serif;margin:0 0 12px;color:var(--ink,#1b1b19)}.ds-prompt b{color:var(--accent,#1c6b52)}.ds-task{display:flex;gap:7px;align-items:baseline;flex-wrap:wrap;font-size:12.5px}.ds-task b{font-size:13.5px}.ds-form{color:var(--accent,#1c6b52);font-size:10.5px;font-weight:650;letter-spacing:.07em;text-transform:uppercase}.ds-gloss{color:var(--gloss,#4c6382);font-size:13px}.ds-lv{color:var(--muted,#6b6b66);font-size:10px;border:1px solid var(--line,#e3e3de);border-radius:999px;padding:0 6px}"
