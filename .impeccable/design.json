      "css": ".ds-ring{width:44px;height:44px;border-radius:50%;display:grid;place-items:center;position:relative;background:conic-gradient(var(--accent,#1c6b52) calc(var(--pct)*3.6deg),var(--line,#e3e3de) 0)}.ds-ring::after{content:'';position:absolute;inset:4px;border-radius:50%;background:var(--panel,#fff)}.ds-ring span{position:relative;z-index:1;font:700 11px ui-sans-serif,system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;font-variant-numeric:tabular-nums}"
    }
