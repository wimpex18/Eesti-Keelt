  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Cornflower, pressing into its darker lower edge.",
      "html": "<button class=\"ds-btn-primary\">Alusta<span class=\"ds-ru\">начать</span></button>",
      "css": ".ds-btn-primary{font-family:Onest,ui-sans-serif,system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;font-weight:700;font-size:15px;min-height:46px;padding:9px 20px;border:0;border-radius:14px;background:#2b50c8;color:#fff;box-shadow:inset 0 -3px 0 #1c3894;cursor:pointer}.ds-btn-primary:active{transform:translateY(1px);box-shadow:inset 0 -1px 0 #1c3894}.ds-ru{margin-left:4px;font-weight:400;font-size:13px;opacity:.86}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "A tinted surface, no outline.",
      "html": "<button class=\"ds-btn-secondary\">Järgmine<span class=\"ds-ru\">дальше</span></button>",
      "css": ".ds-btn-secondary{font-family:Onest,ui-sans-serif,system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;font-weight:700;font-size:15px;min-height:46px;padding:9px 20px;border:0;border-radius:14px;background:#ebe8df;color:#15171b;cursor:pointer}.ds-btn-secondary:hover{background:#e1e7fa;color:#2b50c8}.ds-ru{margin-left:4px;font-weight:400;font-size:13px;color:#5b606a}"
    },
    {
      "name": "Drill",
      "kind": "card",
      "refersTo": "stage",
      "description": "A sheet with beads, a Literata prompt with a cornflower blank, a serif answer field and a black check.",
      "html": "<div class=\"ds-stage\"><div class=\"ds-beads\"><i class=\"ok\"></i><i class=\"no\"></i><i class=\"now\"></i><i></i><i></i></div><p class=\"ds-prompt\"><span class=\"ds-blank\"></span> sa ei tule? — Sest ma olen väsinud.</p><div class=\"ds-row\"><input class=\"ds-answer\" placeholder=\"?\"><button class=\"ds-check\">Kontrolli</button></div></div>",
      "css": ".ds-stage{background:#fbfaf6;border-radius:20px;padding:22px;box-shadow:0 1px 0 #e5e1d7,0 18px 40px -30px rgba(21,23,27,.45)}.ds-beads{display:flex;gap:5px;max-width:260px}.ds-beads i{flex:1;height:7px;border-radius:4px;background:#d8d4c9}.ds-beads .ok{background:#2e7a4f}.ds-beads .no{background:#b3283c}.ds-beads .now{background:#2b50c8}.ds-prompt{font:400 26px/1.4 Literata,Georgia,serif;margin:16px 0 12px}.ds-blank{display:inline-block;min-width:3.2em;border-bottom:3px solid #2b50c8}.ds-row{display:flex;gap:12px}.ds-answer{flex:1;min-height:54px;border:2px solid #15171b;border-radius:14px;padding:0 14px;font:500 17px Literata,Georgia,serif}.ds-check{min-height:54px;padding:0 20px;border:0;border-radius:14px;background:#15171b;color:#f2f0ea;font-family:Onest,ui-sans-serif,system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;font-weight:700}"
    },
    {
      "name": "Hero",
      "kind": "card",
      "refersTo": "hero",
      "description": "The night surface that answers 'what now'.",
      "html": "<div class=\"ds-hero\"><div class=\"ds-eyebrow\">Praegu <span>сейчас · тема 4 из 36</span></div><div class=\"ds-now\">küsisõnad</div><div class=\"ds-of\">вопросительные слова · A1</div></div>",
      "css": ".ds-hero{background:#15171b;color:#f2f0ea;border-radius:28px;padding:26px 22px}.ds-eyebrow{font-family:Onest,ui-sans-serif,system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;font-size:13px;font-weight:700;color:#93a9ff}.ds-eyebrow span{color:#a4a9b3;font-weight:400}.ds-now{font:500 56px/1 Literata,Georgia,serif;letter-spacing:-.03em;margin-top:6px}.ds-of{font-family:Onest,ui-sans-serif,system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;font-size:14px;color:#a4a9b3;margin-top:10px}"
    },
    {
      "name": "Switch",
      "kind": "control",
      "refersTo": "switch",
