.venv/
__pycache__/
*.pyc
*.egg-info/

# Local data caches — large, regenerable, or third-party licensed.
data/raw/
data/cache/
# Runtime databases — all generated, none belong in the repo.
data/*.db
audio-cache/

# HARNO exam material is copyright Haridus- ja Noorteamet.
# Personal study use only — never redistribute or commit.
data/exam/

.env
deploy/ca-bundle.crt

# Worker toolchain — installed, not committed.
node_modules/
.wrangler/

# EKI's level vocabulary and learner dictionary — downloaded by the learner
# from a form EKI ask them to fill in, baked into the image by the Dockerfile.
# CC BY 4.0 and redistributable; not committed because data files here are
# always built or fetched. See deploy/eki/README.md.
# Since 2026-09-13 the files the image imports ARE committed, gzipped — without
# them Cloud Build had none (see Dockerfile). Raw XML, schemas and the extras
# stay local; deploy/eki/README.md says what each became.
deploy/eki/*
!deploy/eki/README.md
!deploy/eki/A1A2B1.txt
!deploy/eki/psv_EKI_CCBY40.xml.gz
!deploy/eki/evs_EKI_CCBY40.xml.gz
!deploy/eki/vsl_EKI_CCBY40.xml.gz
!deploy/eki/har_EKI_CCBY40.xml.gz
!deploy/eki/ekss_EKI_CCBY40.xml.gz
