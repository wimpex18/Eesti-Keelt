{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eesti-keelt",
  "main": "deploy/worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // The Worker is a doorman, not the app. The FastAPI process runs on Google
  // Cloud Run, because it needs Vabamorf — a compiled C++ Python extension that
  // cannot run in a Worker. Cloudflare Containers would have hosted it here,
  // but they require the Workers Paid plan; Cloud Run's always-free tier runs
  // the same image for nothing. See docs/deploy.md.
  //
  // Everything below is therefore free-plan only: a Worker, and one
  // SQLite-backed Durable Object, which Cloudflare made available on the
  // Workers Free plan in April 2025.
  "durable_objects": {
    "bindings": [{ "name": "LEARNER_STATE", "class_name": "LearnerState" }]
  },

  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LearnerState"] }],

  // Speech recognition, via the binding rather than the REST API. The binding
  // needs no API token, so the Cloud Run origin never holds a credential that
  // could edit Workers -- and Workers AI has a free daily allocation, which a
  // learner reading sentences aloud does not approach.
  "ai": { "binding": "AI" },

  "observability": { "enabled": true }

  // Secrets, set with `wrangler secret put` or by the deploy workflow, and
  // never committed:
  //   CLOUD_RUN_URL   https://<service>-<hash>.<region>.run.app
  //   PROXY_TOKEN     shared with the Cloud Run service; without it the
  //                   run.app URL would be a way around Cloudflare Access
  //   STATE_TOKEN     guards the snapshot endpoints
  //   OPENROUTER_API_KEY  optional: grammar explanations
  //
  // And one plain variable, only if you mean it:
  //   ALLOW_UNAUTHENTICATED=1   serve without Cloudflare Access
}
